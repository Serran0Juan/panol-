# Copiá este archivo a .streamlit/secrets.toml (uso local) o pegá el mismo contenido
# en Streamlit Community Cloud > Settings > Secrets (para el despliegue en la nube).
# Los valores salen del JSON de la cuenta de servicio de Google — ver SETUP.md.

[gcp]
sheet_id = "1g2_c8Pqxj_49hOlaTdCZO_-03qUZV4GmDJJMcpUwOoU"

[gcp_service_account]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "...@....iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
