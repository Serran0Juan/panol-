# Copiá este archivo a .streamlit/secrets.toml (uso local) o pegá el mismo contenido
# en Streamlit Community Cloud > Settings > Secrets (para el despliegue en la nube).
# Los valores salen del JSON de la cuenta de servicio de Google — ver SETUP.md.

[gcp]
sheet_id = "ID_DE_TU_GOOGLE_SHEET"

[gcp_service_account]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "...@....iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."

# Primer usuario ADMIN, se carga solo al crear la hoja Usuarios.
[admin]
email = "tu-email@ejemplo.com"
nombre = "Tu Nombre"
sector = "MANTENIMIENTO"

# Código que se pide en el formulario público de pedidos de reparación, el que
# usan médicos y enfermeros desde el QR de su sector. No es una contraseña
# personal: es una palabra que circula dentro del hospital y va escrita en el
# cartel, al lado del QR. Sirve para que el formulario no quede abierto a
# cualquiera de internet.
# Mientras esta clave no esté cargada, el formulario público NO funciona.
[solicitudes]
codigo = "una-palabra-corta-y-facil"
